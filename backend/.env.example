# HOSxP Database (Read-only)
HOSXP_DB_HOST=127.0.0.1
HOSXP_DB_USER=hosxp_user
HOSXP_DB_PASS=hosxp_password
HOSXP_DB_NAME=hos

# Virtual Hospital Database (Read/Write)
VHOS_DB_HOST=127.0.0.1
VHOS_DB_USER=vhos_user
VHOS_DB_PASS=vhos_password
VHOS_DB_NAME=virtualhos

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_API_KEY=your_admin_api_key_here
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# MOPH & LINE APIs
apiMOPHUrl=https://api.moph.go.th
MOPH_CLIENT_KEY=your_moph_client_key
MOPH_SECRET_KEY=your_moph_secret_key
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
RBH_TELEMED_URL=https://telemed.rajburi.org
TELEMED_MAX_APPT_DATE=2026-10-14

# LINE OA Webhook & Chat Center
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_WEBHOOK_PUBLIC_BASE_URL=https://telemed.rajburi.org/api/webhook

# SeaweedFS S3 Gateway API (Hospital Media Storage)
SEAWEEDFS_S3_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_BUCKET=virtualhos
SEAWEEDFS_S3_ACCESS_KEY=your_seaweedfs_access_key
SEAWEEDFS_S3_SECRET_KEY=your_seaweedfs_secret_key
SEAWEEDFS_S3_PREFIX=line-chat
SEAWEEDFS_S3_FORCE_PATH_STYLE=true


